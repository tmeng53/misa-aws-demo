PORT=4010
# Public base URL, used in /openapi.json servers[0] and links. Taken from the request when unset.
PROVIDER_URL=
# Comma list of keys accepted on the Pro plan (give one to Misa). Never commit real values.
PROVIDER_API_KEYS=
# Bearer token for the hidden POST /admin/fault override.
PROVIDER_ADMIN_TOKEN=
# Signs self-serve keys from /signup. Any long random string.
PROVIDER_KEY_SECRET=
# Set automatically on Vercel when a Blob store is connected; keeps failure counts and the override shared across instances.
BLOB_READ_WRITE_TOKEN=
